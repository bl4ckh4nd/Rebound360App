  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:shared --force && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:3000 && npm run build:shared && npm run build:preload && tsc -p tsconfig.electron.json --noEmitOnError false || electron .",
    "build": "npm run clean && npm run build:shared && npm run build:vite && npm run build:preload && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:shared": "tsc -p tsconfig.shared.json",
    "preview": "vite preview",
    "start": "electron-forge start",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "clean": "rimraf dist tsconfig.*.tsbuildinfo",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
