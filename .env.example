# Database Encryption Settings
# Generate a secure random key and salt for production use
ENCRYPTION_KEY=example-encryption-key
ENCRYPTION_SALT=example-salt

# API Settings
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Database Settings
DB_PATH=supplier_returns.db

# Note: For production, replace the encryption key and salt with secure random values
# You can generate them using Node.js crypto:
# crypto.randomBytes(32).toString('hex') for the key
# crypto.randomBytes(16).toString('hex') for the salt 