{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist/main",
    "rootDir": "src/main",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "composite": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "shared/*": ["./dist/shared/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/renderer/electron.d.ts"
  ],
  "exclude": [
    "src/main/**/*test*.ts",
    "src/main/**/*test*.js",
    "src/main/database/test-*.ts",
    "src/main/database/test-*.js"
  ],
  "references": [
    { "path": "./tsconfig.shared.json" }
  ]
}